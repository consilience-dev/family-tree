# Local persistent PostgreSQL (PGlite) is used when DATABASE_URL is empty.
DATABASE_URL=
DEMO_MODE=true
APP_ORIGIN=http://localhost:3000
PORT=3000
# Production: DEMO_MODE=false, NODE_ENV=production, HTTPS APP_ORIGIN.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_VOICE_MODEL=gpt-realtime-2.1
# Optional private S3-compatible bucket. No public access or public ACL.
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
